{
  "schemaVersion": 1,
  "id": "veepee.twingate",
  "name": "Twingate",
  "version": "0.2.0",
  "author": "veepee",
  "license": "MIT",
  "description": "Twingate Zero Trust client in the Omarchy bar: connect and disconnect, your account, and your authorized resources.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Twingate",
    "description": "Show Twingate connection state, toggle the tunnel, see your account, and search and authenticate resources.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 10,
      "visibility": "always",
      "resourceScope": "default"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "visibility",
        "type": "enum",
        "label": "Show in bar",
        "options": [
          {
            "value": "always",
            "label": "Always"
          },
          {
            "value": "when-online",
            "label": "Only when connected"
          },
          {
            "value": "when-installed",
            "label": "Only when the CLI is installed"
          }
        ],
        "defaultValue": "always"
      },
      {
        "key": "resourceScope",
        "type": "enum",
        "label": "Resources to list",
        "options": [
          {
            "value": "default",
            "label": "Visible resources"
          },
          {
            "value": "all",
            "label": "Include hidden resources"
          }
        ],
        "defaultValue": "default"
      }
    ]
  }
}
